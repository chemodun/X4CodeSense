<?xml version="1.0" encoding="UTF-8"?>
<!-- Test schema for X4CodeSense: a small stand-in for the game's md.xsd. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:include schemaLocation="common.xsd" />
  <xs:simpleType name="cuename">
    <xs:annotation>
      <xs:documentation>Cue name</xs:documentation>
    </xs:annotation>
    <xs:restriction base="expression" />
  </xs:simpleType>
  <xs:group name="mdactions">
    <xs:annotation>
      <xs:documentation>The common actions and the ones only the Mission Director has.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="actions" />
      <xs:element name="include_actions">
        <xs:annotation>
          <xs:documentation>Perform actions of the referenced library in the context of this cue</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:attribute name="ref" type="expression" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="run_actions">
        <xs:annotation>
          <xs:documentation>Perform actions of the referenced library in a separate context, providing parameters to the library and optionally receiving a result value.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="param" minOccurs="0" maxOccurs="unbounded">
              <xs:complexType>
                <xs:attribute name="name" type="xs:string" use="required" />
                <xs:attribute name="value" type="expression" use="required" />
              </xs:complexType>
            </xs:element>
          </xs:sequence>
          <xs:attribute name="ref" type="expression" use="required" />
          <xs:attribute name="result" type="lvaluename" />
        </xs:complexType>
      </xs:element>
      <xs:element name="signal_cue_instantly">
        <xs:complexType>
          <xs:attribute name="cue" type="cuename" use="required" />
          <xs:attribute name="param" type="expression" />
        </xs:complexType>
      </xs:element>
      <xs:element name="cancel_cue">
        <xs:complexType>
          <xs:attribute name="cue" type="cuename" use="required" />
        </xs:complexType>
      </xs:element>
    </xs:choice>
    </xs:sequence>
  </xs:group>
  <xs:complexType name="cuepatch">
    <xs:annotation>
      <xs:documentation>Actions for saved games created with an older version of the cue.</xs:documentation>
    </xs:annotation>
    <xs:group ref="mdactions" />
    <xs:attribute name="sinceversion" type="xs:integer" use="required" />
  </xs:complexType>
  <xs:group name="cuebody">
    <xs:sequence>
      <xs:element name="conditions" type="conditions_withref" minOccurs="0" />
      <xs:element name="delay" minOccurs="0">
        <xs:complexType>
          <xs:attribute name="exact" type="expression" />
        </xs:complexType>
      </xs:element>
      <xs:element name="actions" minOccurs="0">
        <xs:complexType>
          <xs:group ref="mdactions" />
        </xs:complexType>
      </xs:element>
      <xs:element name="patch" type="cuepatch" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="cues" type="cues" minOccurs="0" />
    </xs:sequence>
  </xs:group>
  <xs:complexType name="cue">
    <xs:annotation>
      <xs:documentation>A cue.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="param" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Cue parameter (only used if cue is a reference)</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:attribute name="name" type="paramname" use="required" />
          <xs:attribute name="value" type="expression" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:group ref="cuebody" />
    </xs:sequence>
    <xs:attribute name="name" type="scriptname" use="required" />
    <xs:attribute name="ref" type="expression" />
    <xs:attribute name="instantiate" type="boolean" />
    <xs:attribute name="namespace">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="this" />
          <xs:enumeration value="static" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="library">
    <xs:annotation>
      <xs:documentation>A library cue.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="params" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="param" minOccurs="0" maxOccurs="unbounded">
              <xs:annotation>
                <xs:documentation>Library parameter</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="name" type="paramname" use="required" />
                <xs:attribute name="default" type="expression" />
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:group ref="cuebody" />
    </xs:sequence>
    <xs:attribute name="name" type="scriptname" use="required" />
  </xs:complexType>
  <xs:complexType name="cues">
    <xs:sequence>
      <xs:element name="cue" type="cue" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="library" type="library" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="mdscript">
    <xs:annotation>
      <xs:documentation>Root of a Mission Director script.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="cues" type="cues" />
      </xs:sequence>
      <xs:attribute name="name" type="name" use="required" />
    </xs:complexType>
  </xs:element>
</xs:schema>
