{
  "name": "x4codesense",
  "displayName": "X4CodeSense",
  "description": "Language support for X4: Foundations scripts (AI scripts, Mission Director scripts and their patches): diagnostics, completion, hover, navigation, rename and quick fixes, powered by a language server.",
  "version": "0.4.0",
  "private": true,
  "publisher": "X4DevTools",
  "pricing": "Free",
  "icon": "icons/X4CodeSense-icon.png",
  "galleryBanner": {
    "color": "#0b2440",
    "theme": "dark"
  },
  "author": {
    "name": "Chem O'Dun",
    "email": "chemodun@gmail.com"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/chemodun/X4CodeSense.git",
    "directory": "client"
  },
  "homepage": "https://github.com/chemodun/X4CodeSense#readme",
  "bugs": {
    "url": "https://github.com/chemodun/X4CodeSense/issues"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "x4",
    "x4 foundations",
    "egosoft",
    "modding",
    "mission director",
    "aiscript",
    "xml",
    "lua",
    "language server"
  ],
  "activationEvents": [
    "onLanguage:xml",
    "onLanguage:lua",
    "onFileSystem:x4codesense-patch",
    "onFileSystem:x4codesense-patched"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "x4CodeSense.restartServer",
        "title": "Restart Language Server",
        "category": "X4CodeSense"
      },
      {
        "command": "x4CodeSense.selectGameFolder",
        "title": "Select the Extracted Game Files...",
        "category": "X4CodeSense"
      },
      {
        "command": "x4CodeSense.showOutput",
        "title": "Show Output",
        "category": "X4CodeSense"
      },
      {
        "command": "x4CodeSense.openSettings",
        "title": "Open Settings",
        "category": "X4CodeSense"
      },
      {
        "command": "x4CodeSense.openPatchTarget",
        "title": "Open the File This Patch Changes",
        "category": "X4CodeSense",
        "icon": "$(go-to-file)"
      },
      {
        "command": "x4CodeSense.comparePatch",
        "title": "Show What This Patch Changes",
        "category": "X4CodeSense",
        "icon": "$(diff)"
      },
      {
        "command": "x4CodeSense.editPatchWithResult",
        "title": "Edit This Patch Above What It Changes",
        "category": "X4CodeSense",
        "icon": "$(split-vertical)"
      },
      {
        "command": "x4CodeSense.writeSideIntoPatch",
        "title": "Write Changes into the Patch",
        "category": "X4CodeSense",
        "icon": "$(save)"
      },
      {
        "command": "x4CodeSense.showMenu",
        "title": "Show Menu",
        "category": "X4CodeSense"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "x4CodeSense.openPatchTarget",
          "when": "x4CodeSense.documentKind == patch"
        },
        {
          "command": "x4CodeSense.comparePatch",
          "when": "x4CodeSense.documentKind == patch"
        },
        {
          "command": "x4CodeSense.editPatchWithResult",
          "when": "x4CodeSense.documentKind == patch"
        },
        {
          "command": "x4CodeSense.writeSideIntoPatch",
          "when": "resourceScheme == x4codesense-patched"
        },
        {
          "command": "x4CodeSense.showMenu",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "x4CodeSense.comparePatch",
          "when": "x4CodeSense.documentKind == patch && resourceScheme == file && resourceLangId == xml",
          "group": "navigation@1"
        },
        {
          "command": "x4CodeSense.editPatchWithResult",
          "when": "x4CodeSense.documentKind == patch && resourceScheme == file && resourceLangId == xml",
          "group": "navigation@2"
        },
        {
          "command": "x4CodeSense.writeSideIntoPatch",
          "when": "resourceScheme == x4codesense-patched",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "X4CodeSense",
      "properties": {
        "x4CodeSense.unpackedFileLocation": {
          "type": "string",
          "default": "",
          "description": "Path to the extracted vanilla game files (the folder holding aiscripts, md, libraries and t)."
        },
        "x4CodeSense.extensionsFolder": {
          "type": "string",
          "default": "",
          "description": "Where the other extensions are whose texts and scripts yours refer to. Relative to each workspace folder: empty or '.' is the workspace folder itself (a workspace of several mods, or of one mod), '..' the folder above it (one workspace per mod, the mods side by side). An absolute path is taken as is. The folder may be an extension or hold extensions; they are read in the order their content.xml dependencies give."
        },
        "x4CodeSense.languageNumber": {
          "type": "string",
          "default": "44",
          "description": "Preferred language number for text lookups, for example 44 for English."
        },
        "x4CodeSense.limitLanguageOutput": {
          "type": "boolean",
          "default": false,
          "description": "Show only the preferred language in text hovers, and read only the text files of that language and English."
        },
        "x4CodeSense.validateXmlStructure": {
          "type": "boolean",
          "default": true,
          "description": "Check the order and completeness of child elements against the game's XSD schemas. Unknown elements and attributes and invalid attribute values are always reported when the unpacked game files are configured."
        },
        "x4CodeSense.debug": {
          "type": "boolean",
          "default": false,
          "description": "Verbose language server logging in the X4CodeSense output channel."
        },
        "x4CodeSense.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the X4CodeSense language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "bundle": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2",
    "x4-script-core": "0.4.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.104.0"
  }
}
